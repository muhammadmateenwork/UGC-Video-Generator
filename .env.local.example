# Google Gemini — intent classification + creative planning.
# Comma-separated list supported (see lib/gemini.ts) — note this only helps if the
# keys come from genuinely separate Google accounts; keys from the same account
# share one quota pool regardless of how many you generate.
GEMINI_API_KEY=

# Pexels — background video/photo layer. https://www.pexels.com/api/
PEXELS_API_KEY=

# Giphy — GIF overlay layer. https://developers.giphy.com/
GIPHY_API_KEY=

# Freesound — trending-audio layer. https://freesound.org/apiv2/apply/
FREESOUND_API_KEY=

# BLOB_READ_WRITE_TOKEN is auto-provided by Vercel once Blob storage is attached
# to the project on Vercel — not needed for local dev (local dev writes to
# public/generated/ instead, see lib/storage.ts).
